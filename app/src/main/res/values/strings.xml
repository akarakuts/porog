    <string name="help_why_title">What is Porog?</string>
    <string name="help_why_body">Open it when you pick up your phone to leave home. In a few seconds you see the weather, when to leave, what to take, and you can save parking with one tap. No account.</string>
    <string name="help_weather_title">Weather</string>
    <string name="help_weather_body">Uses your location and Open-Meteo. You get the temperature now, the next couple of hours, and a hint: umbrella, jacket, or coat.</string>
    <string name="help_leave_title">When to leave</string>
    <string name="help_leave_body">Porog reads the next event in your calendar and subtracts the commute time from Settings. Traffic is not used in this version.</string>
    <string name="help_checklist_title">Checklist</string>
    <string name="help_checklist_body">Tick keys, wallet, and the rest as you walk out. Checks reset every day. Add your own items in Settings.</string>
    <string name="help_parking_title">Parking</string>
    <string name="help_parking_body">Tap “I parked here” to save a GPS pin. “Find my car” opens the maps app on your phone.</string>
    <string name="help_widget_title">Home screen widget</string>
    <string name="help_widget_body">Add the Porog widget to see temperature and leave-by time without opening the app. Long-press the home screen, choose widgets, find Porog.</string>
    <string name="help_perm_title">Permissions</string>
    <string name="help_perm_body">Location: weather and parking. Calendar: next event (optional). Notifications: leave reminder (optional). Everything stays on the device.</string>
